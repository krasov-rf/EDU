        <mxCell id="aSlLr3PMTJBMmm0a1PQL-31" value="&lt;div&gt;clientDeadline := time.Now().Add(&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;time.Duration(2 * time.Second))&lt;/span&gt;&lt;/div&gt;&lt;div&gt;ctx, cancel := context.WithDeadline(&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;context.Background(), clientDeadline)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
